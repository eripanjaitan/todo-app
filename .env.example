# Neon PostgreSQL. DATABASE_URL = pooled connection, DIRECT_URL = direct connection (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Random string, at least 32 characters. Signs session cookies.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Random string. Vercel sends it to the cron route as a Bearer token.
CRON_SECRET="replace-with-a-random-secret"

# Upstash Redis for rate limiting and failed-attempt counters.
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
